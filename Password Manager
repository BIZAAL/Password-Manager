my_passwords = {}

while True:
    option = input("Would you like to view your passwords, add a new password or delete a password? V/A/D").lower()

    if option == "v":
        print("-------PASSWORDS-------")
        print()
        for title, password in my_passwords.items():
            print(title.upper() + ":")
            
            print("Password: " + my_passwords[title]["password"])
            print("Email: " + my_passwords[title]["email"])
            print("Description: " + my_passwords[title]["description"])
            print()

    elif option == "a":
        choose_thing = input("What would you like the title to be?").lower()
        choose_password = input("What would you like the password to be?") 
        choose_email = input("What would you like the email to be?") 
        choose_description = input("What would you like the description to be?") 

        my_passwords[choose_thing] = {
            "password" : choose_password,
            "email" : choose_email,
            "description" : choose_description
        }

    elif option == "d":
        delete_option = input("Which password would you like to delete?")
        my_passwords.pop(delete_option)

    else:
        print(f"{option} is not an option.")