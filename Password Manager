import json
import os

if os.path.exists('Password Manager Data.json'):
    with open('Password Manager Data.json', 'r') as fp:
        my_passwords = json.load(fp)
else:
    my_passwords = {}



def view_passwords():
    if not my_passwords:
        print("You have no passwords to view.\n")
        return

    print("\n-------PASSWORDS-------")
    for title, info in my_passwords.items():
        print(f"{title.upper()}:")
        print(f"  Password:    {info['password']}")
        print(f"  Email:       {info['email']}")
        print(f"  Description: {info['description']}\n")


def add_password():
    title = input("What would you like the title to be? ").lower()
    
    if title in my_passwords:
        change_quit = input("This title has already been used, would you like to change its details or quit? C/Q").lower().strip()
        
        if change_quit == "c":
            pass
        elif change_quit == "q":
            return
        else:
            print(f"{change_quit} is not an option.")
    
    password = input("What would you like the password to be? ")
    email = input("What would you like the email to be? ")
    description = input("What would you like the description to be? ")

    my_passwords[title] = {
        "password": password,
        "email": email,
        "description": description,
    }
    
    with open('Password Manager Data.json', 'w') as fp:
        json.dump(my_passwords, fp, indent = 4)


def delete_password():
    title = input("Which password would you like to delete? ").lower()

    removed = my_passwords.pop(title, None)

    if removed:
        print(f"Success: '{title}' has been deleted.\n")
        with open('Password Manager Data.json', 'w') as fp:
            json.dump(my_passwords, fp, indent = 4)
    else:
        print(f"Error: '{title}' does not exist.\n")


def main():
    while True:
        print("Options: [V]iew, [A]dd, [D]elete, [Q]uit")
        option = input("Choose an option: ").lower().strip()

        if option == "v":
            view_passwords()
        elif option == "a":
            add_password()
        elif option == "d":
            delete_password()
        elif option == "q":
            print("Goodbye!")
            break
        else:
            print(f"'{option}' is not a valid option. Please try again.\n")


if __name__ == "__main__":
    main()


